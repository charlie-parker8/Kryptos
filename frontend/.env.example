# Frontend build-time config (Vite inlines VITE_* vars at build).
#
# Local dev: leave BOTH unset (or copy this file to .env.local with them blank). The Vite
# dev proxy in vite.config.ts makes the API same-origin, and wsSource.ts derives the WS URL
# from window.location.
#
# Split deploy: set these in the Vercel project's Environment Variables (not committed).
#   VITE_API_URL=https://api.your-domain.com
#   VITE_WS_URL=wss://api.your-domain.com/ws
#
# The SPA serves a public /verify route that reads ?token=… from the emailed link;
# the backend builds that URL from KRYPTOS_FRONTEND_ORIGIN.

VITE_API_URL=
VITE_WS_URL=
