# Copy to .env and adjust as needed. Values here match docker-compose.yml defaults.

KRYPTOS_ENVIRONMENT=development
KRYPTOS_DATABASE_URL=postgresql+asyncpg://kryptos:kryptos@localhost:5432/kryptos
KRYPTOS_REDIS_URL=redis://localhost:6379/0
KRYPTOS_STARTING_CASH_BALANCE=10000.00
KRYPTOS_PRICE_MAX_AGE_SECONDS=10
KRYPTOS_KRAKEN_REST_BASE_URL=https://api.kraken.com
KRYPTOS_KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRYPTOS_KRAKEN_REQUEST_TIMEOUT_SECONDS=5.0

# Candlestick chart — Kraken OHLC intervals (minutes, JSON list) and Redis cache tuning.
KRYPTOS_SUPPORTED_CANDLE_INTERVALS=[1,5,15,60]
KRYPTOS_CANDLE_HISTORY_LIMIT=500
KRYPTOS_CANDLE_HISTORY_TTL_SECONDS=180
KRYPTOS_CANDLE_FORMING_TTL_SECONDS=900
KRYPTOS_KRAKEN_OHLC_SNAPSHOT=false

# Transactional email (Resend). Leave KRYPTOS_RESEND_API_KEY empty for the null backend
# (emails are logged, never sent) — the local/dev default.
KRYPTOS_RESEND_API_KEY=
KRYPTOS_EMAIL_FROM=Kryptos <onboarding@resend.dev>
KRYPTOS_EMAIL_VERIFICATION_TTL_SECONDS=86400

# docker-compose Postgres/Redis container config — kept in sync with KRYPTOS_DATABASE_URL above
POSTGRES_USER=kryptos
POSTGRES_PASSWORD=kryptos
POSTGRES_DB=kryptos
POSTGRES_PORT=5432
REDIS_PORT=6379

# 21st Dev MCP for UI Design
API_KEY_21ST=

